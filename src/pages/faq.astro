---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import { faqPageFaqs, homeFaqs, usageFaqs } from "@/data/faq";
import { getContactMailtoUrl } from "@/lib/contact";

const pageTitle = "FAQ | GoodCoiner";
const pageDescription =
  "グッドコイナーのよくある質問です。iPhoneでの記録、APIキーの安全性、PC版での注文、料金、接続トラブルなどをまとめています。";
const contactUrl = getContactMailtoUrl();

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqPageFaqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.answer,
      },
    })),
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription} structuredData={structuredData}>
  <Header docs docsTone="muted" />
  <main class="min-h-screen bg-[var(--bg-surface-muted)] px-6 pb-20 pt-10 md:px-8 md:pb-28 md:pt-14">
    <div class="mx-auto flex max-w-[1094px] flex-col gap-14 md:gap-20">
      <section class="mx-auto max-w-[760px] text-center">
        <p class="text-[13px] font-bold uppercase tracking-[0.12em] text-[var(--text-tertiary)]">
          よくあるご質問
        </p>
        <h1 class="mt-3 font-avenir text-[44px] font-black leading-[1.05] tracking-[0.03em] text-[var(--text-primary)] md:text-[72px]">
          FAQ
        </h1>
        <p class="mx-auto mt-4 max-w-[720px] text-[15px] leading-8 text-[var(--text-secondary)]">
          グッドコイナーの導入前に知りたいことと、利用方法でつまずきやすいポイントをまとめています。
        </p>
      </section>

      <section class="mx-auto w-full max-w-[866px]">
        <div class="mb-6 flex items-end justify-between gap-4">
          <div>
            <p class="text-[13px] font-bold uppercase tracking-[0.12em] text-[var(--text-tertiary)]">
              購入前
            </p>
            <h2 class="mt-1 font-['Noto_Sans_JP'] text-[24px] font-black leading-tight text-[var(--text-primary)]">
              導入前によくある質問
            </h2>
          </div>
        </div>
        <FaqAccordion items={homeFaqs} />
      </section>

      <section class="mx-auto w-full max-w-[866px]">
        <div class="mb-6 flex items-end justify-between gap-4">
          <div>
            <p class="text-[13px] font-bold uppercase tracking-[0.12em] text-[var(--text-tertiary)]">
              利用方法
            </p>
            <h2 class="mt-1 font-['Noto_Sans_JP'] text-[24px] font-black leading-tight text-[var(--text-primary)]">
              設定・接続でよくある質問
            </h2>
          </div>
        </div>
        <FaqAccordion items={usageFaqs} />
      </section>

      <section class="mx-auto max-w-[760px] text-center">
        <p class="text-[14px] leading-7 text-[var(--text-secondary)]">
          ここにない内容は、お問い合わせから確認できます。
        </p>
        <a
          href={contactUrl}
          class="mt-4 inline-flex min-h-[48px] items-center justify-center gap-2 rounded-[120px] bg-[#e1e5ea] px-10 py-2 font-['Noto_Sans_JP'] text-[16px] font-bold text-[var(--text-primary)] transition hover:bg-[#d5dbe2]"
        >
          お問い合わせ
          <svg viewBox="0 0 20 20" aria-hidden="true" class="h-4 w-4 shrink-0">
            <path d="M8 5L13 10L8 15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>
