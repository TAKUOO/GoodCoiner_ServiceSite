---
export const prerender = false;

import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAppDownloadUrl } from "@/lib/download";
import Stripe from "stripe";

const sessionId = Astro.url.searchParams.get("session_id");
const appDownloadUrl = getAppDownloadUrl(Astro.locals.runtime.env);
let licenseKey: string | null = null;
let planBadge = "月額";
let errorMsg: string | null = null;

const startDate = new Date().toLocaleDateString("ja-JP", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

if (!sessionId) {
  errorMsg = "セッション情報が見つかりません。";
} else {
  try {
    const stripe = new Stripe(Astro.locals.runtime.env.STRIPE_SECRET_KEY);
    const session = await stripe.checkout.sessions.retrieve(sessionId);
    licenseKey = session.metadata?.licenseKey ?? null;
    planBadge = session.metadata?.plan === "yearly" ? "年額" : "月額";

    if (!licenseKey) {
      errorMsg = "ライセンス情報の取得に失敗しました。";
    }
  } catch {
    errorMsg = "セッション情報の取得に失敗しました。";
  }
}
---

<BaseLayout
  title="お支払い完了 | GoodCoiner"
  description="GoodCoiner の購入完了ページです。"
  noindex
>
  <main class="flex min-h-screen items-center justify-center bg-gradient-to-b from-[#eef0f8] to-white px-6 py-16 md:py-20">
    <div class="flex w-full max-w-[760px] flex-col items-center gap-8 text-center">

      {errorMsg ? (
        <div class="flex flex-col items-center gap-6">
          <p class="text-[var(--text-secondary)]">{errorMsg}</p>
          <a
            href="/#pricing"
            class="inline-flex min-h-[48px] items-center justify-center rounded-[82px] border-2 border-[var(--border-strong)] px-10 py-2"
          >
            <span class="font-['Noto_Sans_JP'] text-[16px] font-bold text-[var(--text-primary)]">
              料金ページに戻る
            </span>
          </a>
        </div>
      ) : (
        <>
          <div class="flex flex-col gap-2">
            <h1 class="font-['Noto_Sans_JP'] text-[28px] font-black text-[var(--text-primary)]">
              お支払いが完了しました！
            </h1>
            <p class="font-['Noto_Sans_JP'] text-[15px] text-[var(--text-secondary)]">
              {planBadge}プランが有効になりました！
            </p>
          </div>

          <section class="w-full rounded-[24px] border border-[var(--border-soft)] bg-white p-6 text-left shadow-[0_16px_44px_rgba(13,20,33,0.08)] md:p-8">
            <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
              <div class="flex items-center gap-4 md:gap-5">
                <img
                  src="/assets/icons/app-icon.png"
                  alt="GoodCoiner"
                  class="h-[72px] w-[72px] rounded-[18px] shadow-[0_8px_24px_rgba(0,0,0,0.18)]"
                />
                <div>
                  <p class="font-['Noto_Sans_JP'] text-[18px] font-black text-[var(--text-primary)]">
                    GoodCoiner
                  </p>
                  <div class="mt-2 flex flex-wrap items-center gap-2">
                    <span class="rounded-full bg-[#ffcd18] px-3 py-0.5 font-['Noto_Sans_JP'] text-[12px] font-bold text-[#0d1421]">
                      {planBadge}
                    </span>
                    <span class="font-['Noto_Sans_JP'] text-[12px] text-[var(--text-tertiary)]">
                      {startDate}より
                    </span>
                  </div>
                </div>
              </div>

              <div class="rounded-[18px] bg-[#fff7d6] px-4 py-3 md:min-w-[220px]">
                <p class="font-['Noto_Sans_JP'] text-[12px] font-bold text-[#0d1421]">
                  次のステップ
                </p>
                <p class="mt-1 font-['Noto_Sans_JP'] text-[12px] leading-[1.7] text-[#44516a]">
                  アプリを起動して、購入したプランを反映します。
                </p>
              </div>
            </div>

            <div class="mt-7 rounded-[22px] bg-[#0d1421] p-6 text-center shadow-[0_20px_60px_rgba(13,20,33,0.16)]">
              <p class="font-['Noto_Sans_JP'] text-[18px] font-black text-white">
                アプリで利用を開始する
              </p>
              <p class="mx-auto mt-3 max-w-[460px] font-['Noto_Sans_JP'] text-[13px] leading-[1.8] text-white/60">
                ボタンを押すとGoodCoinerが起動し、購入したプランが反映されます。
              </p>
              <button
                id="open-app-btn"
                type="button"
                data-session-id={sessionId}
                class="mx-auto mt-6 inline-flex min-h-[56px] w-full max-w-[440px] items-center justify-center rounded-[82px] bg-[var(--accent-yellow)] px-8 py-2 text-center transition-opacity hover:opacity-90 disabled:opacity-60"
              >
                <span class="font-['Noto_Sans_JP'] text-[16px] font-bold text-[var(--text-primary)]">
                  アプリで利用を開始する
                </span>
              </button>
              <p id="activation-error" class="mt-3 hidden font-['Noto_Sans_JP'] text-[11px] leading-[1.7] text-red-300">
                連携コードの発行に失敗しました。少し時間を置いて再度お試しください。
              </p>
            </div>

            <div class="mt-5 flex flex-col gap-3 rounded-[16px] bg-[#f7f8fb] p-4 md:flex-row md:items-center md:justify-between">
              <div>
                <p class="font-['Noto_Sans_JP'] text-[12px] font-bold text-[var(--text-primary)]">
                  まだアプリをインストールしていない場合
                </p>
                <p class="mt-1 font-['Noto_Sans_JP'] text-[11px] leading-[1.7] text-[var(--text-secondary)]">
                  PC版をインストールしてから、このページに戻って利用を開始してください。
                </p>
              </div>
              <a
                href={appDownloadUrl}
                class="inline-flex min-h-[42px] shrink-0 items-center justify-center rounded-[82px] border border-[var(--border-strong)] px-5 py-2 text-center transition hover:bg-white"
              >
                <span class="font-['Noto_Sans_JP'] text-[12px] font-bold text-[var(--text-primary)]">
                  PC版をダウンロード
                </span>
              </a>
            </div>
          </section>

          <details class="w-full rounded-[18px] border border-[var(--border-soft)] bg-white p-4 text-left">
            <summary class="cursor-pointer font-['Noto_Sans_JP'] text-[13px] font-bold text-[var(--text-primary)] select-none">
              アプリが起動しない場合
            </summary>
            <div class="mt-4 rounded-[12px] bg-[#fafafa] p-4">
              <p class="mb-2 font-['Noto_Sans_JP'] text-[11px] leading-[1.7] text-[var(--text-tertiary)]">
                アプリが自動で起動しない場合は、手動連携コードを表示して、アプリの設定画面にある決済連携欄へ入力してください。コードは短時間で期限切れになります。
              </p>
              <button
                id="show-code-btn"
                type="button"
                data-session-id={sessionId}
                class="mt-2 inline-flex min-h-[40px] items-center justify-center rounded-[82px] border border-[var(--border-strong)] px-5 py-2 text-center transition hover:bg-white disabled:opacity-60"
              >
                <span class="font-['Noto_Sans_JP'] text-[12px] font-bold text-[var(--text-primary)]">
                  手動連携コードを表示
                </span>
              </button>
              <p id="manual-code" class="font-avenir mt-3 hidden select-all break-all text-[13px] font-bold tracking-wider text-[var(--text-primary)]"></p>
              <p id="manual-code-note" class="mt-2 hidden font-['Noto_Sans_JP'] text-[10px] leading-[1.6] text-[var(--text-tertiary)]">
                このコードは一回限り有効です。第三者に共有しないでください。
              </p>
            </div>
          </details>

        </>
      )}
    </div>
  </main>
</BaseLayout>

<script>
type ActivationTokenResponse = {
    activationToken: string;
    deepLink: string;
  };

  let cachedActivation: ActivationTokenResponse | null = null;

  const issueActivationToken = async (sessionId: string) => {
    if (cachedActivation?.activationToken && cachedActivation.deepLink) {
      return cachedActivation;
    }

    const response = await fetch("/api/billing/activation-token", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        Accept: "application/json",
      },
      body: JSON.stringify({ sessionId }),
    });

    if (!response.ok) {
      throw new Error("Activation token request failed");
    }

    const body = (await response.json()) as ActivationTokenResponse;
    if (!body.activationToken || !body.deepLink) {
      throw new Error("Activation token response is invalid");
    }

    cachedActivation = body;
    return body;
  };

  const setButtonLoading = (button: HTMLButtonElement, loading: boolean) => {
    button.disabled = loading;
    button.dataset.originalText ??= button.textContent?.trim() ?? "";
    const label = button.querySelector("span");
    if (label) {
      label.textContent = loading ? "連携を準備しています..." : button.dataset.originalText;
    }
  };

  const showActivationError = () => {
    document.getElementById("activation-error")?.classList.remove("hidden");
  };

  const openAppButton = document.getElementById("open-app-btn") as HTMLButtonElement | null;
  if (openAppButton) {
    openAppButton.addEventListener("click", async () => {
      const sessionId = openAppButton.dataset.sessionId;
      if (!sessionId) return;

      setButtonLoading(openAppButton, true);
      try {
        const activation = await issueActivationToken(sessionId);
        window.location.href = activation.deepLink;
      } catch {
        showActivationError();
      } finally {
        setButtonLoading(openAppButton, false);
      }
    });
  }

  const showCodeButton = document.getElementById("show-code-btn") as HTMLButtonElement | null;
  if (showCodeButton) {
    showCodeButton.addEventListener("click", async () => {
      const sessionId = showCodeButton.dataset.sessionId;
      if (!sessionId) return;

      setButtonLoading(showCodeButton, true);
      try {
        const activation = await issueActivationToken(sessionId);
        const code = document.getElementById("manual-code");
        const note = document.getElementById("manual-code-note");
        if (code) {
          code.textContent = activation.activationToken ?? "";
          code.classList.remove("hidden");
        }
        note?.classList.remove("hidden");
      } catch {
        showActivationError();
      } finally {
        setButtonLoading(showCodeButton, false);
      }
    });
  }
</script>
