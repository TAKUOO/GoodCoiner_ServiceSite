---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Hero from "@/components/Hero.astro";
import Features from "@/components/Features.astro";
import Safety from "@/components/Safety.astro";
import Story from "@/components/Story.astro";
import Pricing from "@/components/Pricing.astro";
import Faq from "@/components/Faq.astro";
import Footer from "@/components/Footer.astro";
import { homeFaqs } from "@/data/home-faqs";
import { getAppDownloadUrl } from "@/lib/download";

const siteUrl = Astro.site ?? Astro.url;
const appDownloadUrl = new URL(getAppDownloadUrl(import.meta.env), siteUrl).toString();
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL("/ogp.png", siteUrl).toString();
const pageTitle = "GoodCoiner | iPhoneで続ける、無料のトレード日記";
const pageDescription =
  "iPhoneでトレードを記録し、取引履歴・損益・ルールをあとから振り返る無料アプリ。OSS版も準備中です。";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "GoodCoiner",
    alternateName: "グッドコイナー",
    description: pageDescription,
    url: pageUrl,
    image: ogImageUrl,
    applicationCategory: "FinanceApplication",
    operatingSystem: "iOS, macOS",
    inLanguage: "ja-JP",
    downloadUrl: appDownloadUrl,
    offers: [
      {
        "@type": "Offer",
        name: "無料プラン",
        price: "0",
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
      },
      {
        "@type": "Offer",
        name: "GoodCoiner Pro（準備中）",
        price: "0",
        priceCurrency: "JPY",
        availability: "https://schema.org/PreOrder",
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: homeFaqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.answer,
      },
    })),
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredData={structuredData}
  preloadImages={[{ href: "/dashboard-poster.webp", type: "image/webp", fetchPriority: "high" }]}
>
  <Header />
  <main>
    <Hero />
    <div class="relative -mb-px bg-white">
      <div class="relative z-10">
        <Features />
        <Safety />
        <img
          src="/figma/safety/bg.svg"
          alt=""
          aria-hidden="true"
          class="pointer-events-none absolute bottom-[-1px] left-1/2 z-0 w-[max(1438px,100vw)] max-w-none -translate-x-1/2 select-none"
        />
      </div>
    </div>
    <Story />
    <Pricing />
    <Faq />
  </main>
  <Footer />
</BaseLayout>
