# Stripe (test mode)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_MONTHLY_PRICE_ID=your_monthly_price_id_here
STRIPE_YEARLY_PRICE_ID=your_yearly_price_id_here

# リダイレクト先 URL
STRIPE_SUCCESS_URL=http://localhost:4321/success
STRIPE_CANCEL_URL=http://localhost:4321/#pricing

# サイト URL
PUBLIC_APP_ENV=local
PUBLIC_SERVICE_SITE_URL=http://localhost:4321
PUBLIC_SITE_URL=http://localhost:4321

# CORS: デスクトップアプリの origin (Electron の場合は app:// または localhost:port)
ALLOWED_ORIGIN=http://localhost:1212

# 市場イベント連携 (/api/market-events)
# macro は ForexFactory の無料フィード(faireconomy.media)を使用するためキー不要。
# crypto イベント連携 (次フェーズ) で Coindar の API キーを使用予定。
COINDAR_API_KEY=your_coindar_api_key_here
